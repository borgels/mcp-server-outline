# Outline instance base URL (the server appends /api). E.g. https://outline.example.com
OUTLINE_BASE_URL=
# API token (Outline: Settings -> API -> Create). Inherits the creating user's permissions.
OUTLINE_API_TOKEN=
OUTLINE_TIMEOUT_MS=30000
# Write tools (create/update/move/archive/delete docs, comments, collections) require exactly "true".
# Permanent/cascading deletes (collections.delete, permanent doc delete, empty_trash) are never exposed.
OUTLINE_ENABLE_WRITES=false
OUTLINE_AUDIT_LOG=
# HTTP transport. MCP_HTTP_TOKEN is the bearer token required on every /mcp
# request (compared in constant time, at least 32 printable ASCII characters).
# It is required when MCP_HTTP_HOST is not a loopback address.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_ALLOWED_HOSTS=
MCP_HTTP_TOKEN=
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
