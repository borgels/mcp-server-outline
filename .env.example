# Outline instance base URL (the server appends /api). E.g. https://playbook.example.com
OUTLINE_BASE_URL=

# --- Hosted mode (HTTP): personal API key per user, no shared workspace token ---
# Encrypts the per-user key store at rest (openssl rand -hex 32). Required by dist/http.js.
OUTLINE_ENCRYPTION_KEY=
# Where the encrypted store lives (Docker volume).
OUTLINE_STORE_PATH=/data/store.json
# Public origin of THIS instance — used to build the enrollment link users open.
OUTLINE_PUBLIC_BASE_URL=https://playbook.example.mcp.borgels.com
# Bind every call to the gateway-verified user (X-MCP-User). Required behind the gateway.
OUTLINE_TRUST_FORWARDED_USER=true

# --- Local/stdio mode only: single user, one token from the environment ---
# API token (Outline: Settings -> API -> Create). Inherits the creating user's permissions.
# Ignored by the HTTP transport, which always uses the calling user's own key.
OUTLINE_API_TOKEN=

OUTLINE_TIMEOUT_MS=30000
# Write tools (create/update/move/archive/delete docs, comments, collections) require exactly "true".
# Permanent/cascading deletes (collections.delete, permanent doc delete, empty_trash) are never exposed.
OUTLINE_ENABLE_WRITES=false
OUTLINE_AUDIT_LOG=
