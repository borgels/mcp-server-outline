# Outline instance base URL (the server appends /api). E.g. https://playbook.example.com
OUTLINE_BASE_URL=
# API token (Outline: Settings -> API -> Create). Inherits the creating user's permissions.
OUTLINE_API_TOKEN=
OUTLINE_TIMEOUT_MS=30000
# Write tools (create/update/move/archive/delete docs, comments, collections) require exactly "true".
# Permanent/cascading deletes (collections.delete, permanent doc delete, empty_trash) are never exposed.
OUTLINE_ENABLE_WRITES=false
OUTLINE_AUDIT_LOG=
