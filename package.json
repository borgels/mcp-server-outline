{
  "name": "mcp-server-outline",
  "version": "0.5.1",
  "mcpName": "io.github.borgels/mcp-server-outline",
  "description": "MCP server for the Outline knowledge base (wiki) API.",
  "type": "module",
  "main": "./dist/stdio.js",
  "exports": {
    ".": "./dist/stdio.js",
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "bin": {
    "mcp-server-outline": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsup --entry.stdio src/transports/stdio.ts --entry.http src/transports/http.ts --entry.gateway src/gateway.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build",
    "smoke:live": "tsx test/live-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-outline.git"
  },
  "keywords": [
    "mcp",
    "outline",
    "wiki",
    "knowledge-base"
  ],
  "author": "",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=22.19.0"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-outline/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-outline#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ipaddr.js": "2.5.0",
    "undici": "8.13.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ip-address": "^10.1.1",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.8",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
